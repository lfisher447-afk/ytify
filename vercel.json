{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(search|playlist|album|artist|channel|similar|featured|subfeed|fix-metadata|stream-gate|catalog|recommend|cron|library|sync|syncHash|hash|video-stream)(.*)",
      "destination": "/api/$1$2"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
